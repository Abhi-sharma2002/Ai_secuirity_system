# Backend-only configuration. Automatically loaded from the repository root.
# Existing process environment variables take precedence. Restart after editing.
# Leave live disabled until actual free/promotional allowance and model access are confirmed.
# FREE_ONLY=true
# LIVE_LLM_ENABLED=false
# GROQ_API_KEY=YOUR_GROQ_API_KEY
# GROQ_MODEL=openai/gpt-oss-20b
# FREE_ALLOWANCE_FILE=
FREE_ONLY=true
LIVE_LLM_ENABLED=false

GROQ_API_KEY=YOUR_GROQ_API_KEYGROQ_MODEL=openai/gpt-oss-20b
FREE_ALLOWANCE_FILE=/home/sigmoid/Ai-Security-Poc/.private/free_allowance.json

# Paths below are relative to the repository root, regardless of startup cwd.
# APP_DATA_DIRECTORY also contains saved experiments under experiments/.
APP_DATA_DIRECTORY=backend/data/runtime
DOCUMENT_DIRECTORY=backend/data/documents
UPLOAD_DIRECTORY=backend/data/uploads
CHROMA_DB_PATH=backend/data/chroma_db

# Existing local CPU embedding and retrieval defaults.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=16
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
MAX_DOCUMENT_BYTES=5242880
EVIDENCE_MAX_CHARACTERS=100000
EVIDENCE_MAX_BYTES=400000
IGNORED_DOCUMENT_ENTRIES=.gitkeep
LOG_LEVEL=INFO

# Used by the shared Groq adapter and the historical provider-neutral client.
# Provider retries remain disabled in the Groq runtime.
LLM_REQUEST_TIMEOUT_SECONDS=30
