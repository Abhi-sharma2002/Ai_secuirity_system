# Backend configuration: copy to .env only if .env does not already exist.
# Keep credentials private. The temporary default is the fixed OpenRouter free route.
LLM_BACKEND=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_ALLOWANCE_FILE=.private/openrouter_allowance.json
# Azure remains available by switching LLM_BACKEND and configuring these values.
# LLM_BACKEND=azure_openai
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_ALLOWANCE_FILE=.private/azure_allowance.json
FREE_ONLY=true
LIVE_LLM_ENABLED=false

# Paths below are relative to the repository root, regardless of startup cwd.
# APP_DATA_DIRECTORY also contains saved experiments under experiments/.
APP_DATA_DIRECTORY=backend/data/runtime
DOCUMENT_DIRECTORY=backend/data/documents
UPLOAD_DIRECTORY=backend/data/uploads
CHROMA_DB_PATH=backend/data/chroma_db

# Existing local CPU embedding and retrieval defaults.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=16
CHUNK_SIZE=10
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
MAX_DOCUMENT_BYTES=5242880
EVIDENCE_MAX_CHARACTERS=100000
EVIDENCE_MAX_BYTES=400000
IGNORED_DOCUMENT_ENTRIES=.gitkeep
LOG_LEVEL=INFO

# Shared provider HTTP timeout; zero retries and output cap 700 remain fixed.
LLM_REQUEST_TIMEOUT_SECONDS=30
